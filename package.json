{
  "name": "atelier",
  "version": "0.0.0",
  "private": true,
  "description": "Cowork-style desktop AI workspace: Go host service + Python/OpenHands guest agent + Electron/React UI. See docs/README.md.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm --prefix apps/desktop run start",
    "build": "npm --prefix apps/desktop run package",
    "lint": "npm --prefix apps/desktop run lint",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "format": "npm --prefix apps/desktop run format",
    "typecheck": "npm --prefix apps/desktop run typecheck",
    "test": "npm --prefix apps/desktop run test",
    "protogen": "node tools/protogen/protogen.mjs",
    "build:all": "node scripts/build-all.mjs",
    "e2e:host": "node scripts/e2e-host.mjs",
    "test:partisan": "node scripts/test-partisan.mjs"
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.22.1"
  }
}
